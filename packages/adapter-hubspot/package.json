{
  "name": "@udmp/adapter-hubspot",
  "version": "1.0.0-rc.1",
  "description": "UDMP exporter for HubSpot CRM (v3 objects, v3 properties, v4 associations, Files API).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist"],
  "udmp": { "platform": "hubspot", "udmp_version": "1.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": { "@udmp/core": "workspace:*" }
}
