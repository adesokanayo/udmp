{
  "name": "@udmp/core",
  "version": "1.0.0-rc.1",
  "description": "UDMP (Universal Data Migration Protocol) core: manifest types, validation, bundle reader/writer, integrity checks, export runner and SQLite importer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "schema"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('../../schemas','./schema',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "turndown": "^7.2.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5"
  }
}
