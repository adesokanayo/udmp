{
  "name": "udmp",
  "version": "1.0.0-rc.1",
  "description": "The UDMP command line: validate, inspect, export, import, and turn SaaS data into SQLite.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "udmp": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@udmp/core": "workspace:*"
  },
  "optionalDependencies": {
    "@udmp/adapter-linear": "workspace:*",
    "@udmp/adapter-hubspot": "workspace:*",
    "@udmp/adapter-twenty": "workspace:*"
  }
}
